{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conductor",
  "version": "0.1.0",
  "identifier": "com.sirbepy.conductor.mobile",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Conductor",
        "width": 420,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://127.0.0.1:27184; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "android": {
      "minSdkVersion": 28
    }
  }
}
