{
  "manifest_version": 3,
  "name": "Claude Conductor Browser Bridge",
  "version": "1.0.0",
  "description": "Lets Claude Conductor chats drive this browser profile, each in its own window.",
  "key": "",
  "minimum_chrome_version": "125",
  "background": { "service_worker": "background.js" },
  "permissions": ["debugger", "tabs", "webNavigation", "nativeMessaging", "alarms", "storage"]
}
