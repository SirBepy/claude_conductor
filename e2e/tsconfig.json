{
  // View-harness specs, kept out of the root project so Playwright types stay
  // off the app. The `"/*"` paths entry mirrors vite.config.ts's `root: src/`,
  // which is what makes the specs' `import("/views/...")` resolve under tsc;
  // those specifiers are real browser-side imports, not aliases.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    // The `/views/...` specifiers carry a `.ts` extension, so tsc has to accept it.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "types": ["node", "vite/client"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"],
      "/*": ["src/*"]
    }
  },
  "include": ["view-harness/**/*.ts"],
  "exclude": ["../node_modules", "../dist", "../src-tauri/target"]
}
