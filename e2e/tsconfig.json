{
  // View-harness specs, kept out of the root project so Playwright types stay
  // off the app. The `"/*"` paths entry mirrors vite.config.ts's `root: src/`,
  // which is what makes the specs' `import("/views/...")` resolve under tsc;
  // those specifiers are real browser-side imports, not aliases.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The `/views/...` specifiers carry a `.ts` extension, so tsc has to accept it.
    "allowImportingTsExtensions": true,
    // Root sets this true; the specs are where we want lib errors to stay visible.
    "skipLibCheck": false,
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"],
      "/*": ["src/*"]
    }
  },
  "include": ["view-harness/**/*.ts"],
  "exclude": ["../node_modules", "../dist", "../src-tauri/target"]
}
